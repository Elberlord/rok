{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomCode": {
        ".read": "auth != null",
        ".write": "auth != null && ((newData.exists() && ((!data.exists() && newData.child('hostUid').val() === auth.uid) || data.child('hostUid').val() === auth.uid || data.child('guestUid').val() === auth.uid || (!data.child('guestUid').exists() && newData.child('guestUid').val() === auth.uid))) || (!newData.exists() && data.child('hostUid').val() === auth.uid))",
        ".validate": "$roomCode.matches(/^[A-HJ-NP-Z2-9]{6}$/)",
        "hostUid": {
          ".validate": "newData.isString() && ((!data.exists() && newData.val() === auth.uid) || newData.val() === data.val())"
        },
        "guestUid": {
          ".validate": "!newData.exists() || (newData.isString() && ((!data.exists() && newData.val() === auth.uid) || newData.val() === data.val()))"
        },
        "schemaVersion": {
          ".validate": "newData.isNumber() && newData.val() === 2"
        },
        "code": {
          ".validate": "newData.isString() && newData.val() === $roomCode"
        },
        "status": {
          ".validate": "newData.isString() && (newData.val() === 'waiting' || newData.val() === 'ready' || newData.val() === 'active' || newData.val() === 'closed')"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "players": {
          "$playerId": {
            ".validate": "$playerId === '1' || $playerId === '2'"
          }
        },
        "game": {
          ".validate": "!newData.exists() || (newData.child('revision').isNumber() && newData.child('writerUid').isString() && newData.child('writerPlayer').isNumber() && newData.hasChild('snapshot'))"
        },
        "interaction": {
          ".validate": "!newData.exists() || (newData.child('id').isString() && newData.child('type').isString() && newData.child('status').isString())"
        }
      }
    }
  }
}
