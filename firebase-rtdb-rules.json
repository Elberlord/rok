{
  "rules": {
    "rooms": {
      "$roomCode": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && (data.child('hostUid').val() === auth.uid || data.child('guestUid').val() === auth.uid || (data.child('status').val() === 'open' && root.child('friends').child(auth.uid).child(data.child('hostUid').val()).exists()))",
        ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && data.child('hostUid').val() === auth.uid && !newData.exists()",
        "hostUid": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && !data.exists() && newData.val() === auth.uid",
          ".validate": "newData.isString()"
        },
        "guestUid": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && ((!data.exists() && newData.val() === auth.uid && newData.parent().child('hostUid').exists() && newData.parent().child('hostUid').val() !== auth.uid && newData.parent().child('status').val() === 'open' && root.child('friends').child(auth.uid).child(newData.parent().child('hostUid').val()).exists()) || (data.exists() && !newData.exists() && (data.val() === auth.uid || data.parent().child('hostUid').val() === auth.uid)))",
          ".validate": "!newData.exists() || newData.isString()"
        },
        "status": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && ((!data.exists() && newData.val() === 'open' && newData.parent().child('hostUid').val() === auth.uid) || (data.parent().child('hostUid').val() === auth.uid && (newData.val() === 'open' || newData.val() === 'full' || newData.val() === 'countdown' || newData.val() === 'playing' || newData.val() === 'finished' || newData.val() === 'waiting' || newData.val() === 'ready'))) ",
          ".validate": "newData.isString()"
        },
        "createdAt": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && !data.exists() && newData.isNumber() && newData.parent().child('hostUid').val() === auth.uid",
          ".validate": "newData.isNumber()"
        },
        "arenaId": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && newData.parent().child('hostUid').val() === auth.uid",
          ".validate": "newData.isString() && (newData.val() === 'classic' || newData.val() === 'egypt')"
        },
        "startAt": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && data.parent().child('hostUid').val() === auth.uid",
          ".validate": "!newData.exists() || newData.isNumber()"
        },
        "players": {
          "$uid": {
            ".read": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && (root.child('rooms').child($roomCode).child('hostUid').val() === auth.uid || root.child('rooms').child($roomCode).child('guestUid').val() === auth.uid)",
            ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && auth.uid === $uid && (root.child('rooms').child($roomCode).child('hostUid').val() === auth.uid || root.child('rooms').child($roomCode).child('guestUid').val() === auth.uid)"
          }
        },
        "game": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && (root.child('rooms').child($roomCode).child('hostUid').val() === auth.uid || root.child('rooms').child($roomCode).child('guestUid').val() === auth.uid)",
          ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && (root.child('rooms').child($roomCode).child('hostUid').val() === auth.uid || root.child('rooms').child($roomCode).child('guestUid').val() === auth.uid)"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "openRooms": {
      "$hostUid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && (auth.uid === $hostUid || root.child('friends').child(auth.uid).child($hostUid).exists())",
        "$roomCode": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && (auth.uid === $hostUid || (!newData.exists() && root.child('rooms').child($roomCode).child('hostUid').val() === $hostUid && root.child('rooms').child($roomCode).child('guestUid').val() === auth.uid))",
          ".validate": "!newData.exists() || (newData.hasChildren(['hostUid','hostName','avatarId','level','arenaId','createdAt']) && newData.child('hostUid').val() === $hostUid && newData.child('hostName').isString() && newData.child('avatarId').isString() && newData.child('level').isNumber() && newData.child('arenaId').isString() && newData.child('createdAt').isNumber())"
        }
      }
    },
    "socialProfiles": {
      "$uid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous'",
        ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && auth.uid === $uid",
        ".validate": "newData.hasChildren(['friendCode','displayName','createdAt','updatedAt'])",
        "friendCode": {
          ".validate": "newData.isString()"
        },
        "displayName": {
          ".validate": "newData.isString()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "avatarId": {
          ".validate": "newData.isString()"
        },
        "level": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 999"
        },
        "xp": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "$other": {
          ".validate": false
        },
        "casterAvatarUrl": {
          ".validate": "newData.isString()"
        }
      }
    },
    "friendCodes": {
      "$code": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous'",
        ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && (!newData.exists() || newData.val() === auth.uid)))",
        ".validate": "!newData.exists() || (newData.isString() && newData.val() === auth.uid)"
      }
    },
    "friendRequests": {
      "$targetUid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && auth.uid === $targetUid",
        "$senderUid": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && $targetUid !== $senderUid && (auth.uid === $senderUid || auth.uid === $targetUid)",
          ".validate": "!newData.exists() || (newData.hasChildren(['fromUid','fromName','fromCode','createdAt']) && newData.child('fromUid').val() === $senderUid && newData.child('fromName').isString() && newData.child('fromCode').isString() && newData.child('createdAt').isNumber())"
        }
      }
    },
    "sentFriendRequests": {
      "$senderUid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && auth.uid === $senderUid",
        "$targetUid": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && $senderUid !== $targetUid && (auth.uid === $senderUid || auth.uid === $targetUid)",
          ".validate": "!newData.exists() || (newData.hasChildren(['targetUid','targetName','targetCode','createdAt']) && newData.child('targetUid').val() === $targetUid && newData.child('targetName').isString() && newData.child('targetCode').isString() && newData.child('createdAt').isNumber())"
        }
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && auth.uid === $uid",
        "$friendUid": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && $uid !== $friendUid && ((!newData.exists() && (auth.uid === $uid || auth.uid === $friendUid)) || (newData.exists() && ((auth.uid === $uid && root.child('friendRequests').child($uid).child($friendUid).child('fromUid').val() === $friendUid) || (auth.uid === $friendUid && root.child('friendRequests').child($friendUid).child($uid).child('fromUid').val() === $uid))))",
          ".validate": "!newData.exists() || (newData.hasChildren(['uid','since']) && newData.child('uid').val() === $friendUid && newData.child('since').isNumber())"
        }
      }
    },
    "avatarJobs": {
      "$uid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && auth.uid === $uid",
        "$jobId": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && auth.uid === $uid",
          ".validate": "newData.hasChildren(['uid','status','createdAt','updatedAt']) && newData.child('uid').val() === $uid && newData.child('status').isString() && newData.child('createdAt').isNumber() && newData.child('updatedAt').isNumber()",
          "uid": {
            ".validate": "newData.val() === $uid"
          },
          "status": {
            ".validate": "newData.isString() && (newData.val() === 'queued' || newData.val() === 'processing' || newData.val() === 'completed' || newData.val() === 'failed')"
          },
          "sourcePath": {
            ".validate": "!newData.exists() || newData.isString()"
          },
          "sourceContentType": {
            ".validate": "!newData.exists() || newData.isString()"
          },
          "promptVersion": {
            ".validate": "!newData.exists() || newData.isString()"
          },
          "mode": {
            ".validate": "!newData.exists() || newData.isString()"
          },
          "resultUrl": {
            ".validate": "!newData.exists() || newData.isString()"
          },
          "mock": {
            ".validate": "!newData.exists() || newData.isBoolean()"
          },
          "completedAt": {
            ".validate": "!newData.exists() || newData.isNumber()"
          },
          "errorMessage": {
            ".validate": "!newData.exists() || newData.isString()"
          },
          "$other": {
            ".validate": false
          },
          "sourceImageData": {
            ".validate": "!newData.exists() || newData.isString()"
          },
          "sourceImageMime": {
            ".validate": "!newData.exists() || newData.isString()"
          },
          "sourceImageWidth": {
            ".validate": "!newData.exists() || newData.isNumber()"
          },
          "sourceImageHeight": {
            ".validate": "!newData.exists() || newData.isNumber()"
          },
          "sourceImageBytes": {
            ".validate": "!newData.exists() || newData.isNumber()"
          }
        }
      }
    }
  }
}